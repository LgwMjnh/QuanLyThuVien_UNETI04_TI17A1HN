
@model IEnumerable<QuanLyThuVien_UNETI04_TI17A1HN.Models.PhieuMuon>

@{
    ViewData["Title"] = "Quản lý mượn trả";

    string? trangThaiLoc = ViewBag.TrangThaiLoc as string;
    string tuKhoa = ViewBag.TuKhoa as string ?? "";

    DateTime? ngayTu = ViewBag.NgayTu == null ? null : (DateTime?)ViewBag.NgayTu;
    DateTime? ngayDen = ViewBag.NgayDen == null ? null : (DateTime?)ViewBag.NgayDen;

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 0;

    int tongPhieu = ViewBag.TongPhieu ?? 0;
    int choXacNhan = ViewBag.ChoXacNhan ?? 0;
    int dangMuon = ViewBag.DangMuon ?? 0;
    int quaHan = ViewBag.QuaHan ?? 0;
    int daTra = ViewBag.DaTra ?? 0;
    int tuChoi = ViewBag.TuChoi ?? 0;

    string ngayTuText = ngayTu?.ToString("yyyy-MM-dd") ?? "";
    string ngayDenText = ngayDen?.ToString("yyyy-MM-dd") ?? "";

    int soThuTu = (trangHienTai - 1) * 10 + 1;
}

<div class="container-fluid py-4">

    <!-- TIÊU ĐỀ VÀ CÁC NÚT ĐIỀU HƯỚNG -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">QUẢN LÝ MƯỢN TRẢ</h2>
            <p class="text-muted mb-0">
                Theo dõi và quản lý các phiếu mượn, trả sách.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="MuonTra"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Lập phiếu mượn
            </a>

            <a asp-controller="MuonTra"
               asp-action="TraCuuDocGia"
               class="btn btn-primary">
                <i class="bi bi-person-search me-1"></i>
                Tìm kiếm độc giả
            </a>

            <a asp-controller="ThongKe"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-bar-chart-fill me-1"></i>
                Thống kê thư viện
            </a>

        </div>
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["ThongBao"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- THÔNG BÁO LỖI -->
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Loi"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 6 THẺ THỐNG KÊ TỔNG QUAN -->
    <div class="row g-3 mb-4">

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng phiếu mượn</div>
                    <h3 class="fw-bold text-primary mb-0">@tongPhieu</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Chờ xác nhận</div>
                    <h3 class="fw-bold text-warning mb-0">@choXacNhan</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Đang mượn</div>
                    <h3 class="fw-bold text-info mb-0">@dangMuon</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Quá hạn</div>
                    <h3 class="fw-bold text-danger mb-0">@quaHan</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Đã trả</div>
                    <h3 class="fw-bold text-success mb-0">@daTra</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Từ chối</div>
                    <h3 class="fw-bold text-secondary mb-0">@tuChoi</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- BỘ LỌC TRẠNG THÁI PHIẾU MƯỢN -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Lọc phiếu mượn</h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Index"
                   class="btn btn-sm @(string.IsNullOrEmpty(trangThaiLoc) ? "btn-primary" : "btn-outline-primary")">
                    Tất cả
                </a>

                <a asp-action="Index"
                   asp-route-trangThai="ChoXacNhan"
                   class="btn btn-sm @(trangThaiLoc == "ChoXacNhan" ? "btn-warning" : "btn-outline-warning")">
                    Chờ xác nhận
                </a>

                <a asp-action="Index"
                   asp-route-trangThai="DangMuon"
                   class="btn btn-sm @(trangThaiLoc == "DangMuon" ? "btn-info" : "btn-outline-info")">
                    Đang mượn
                </a>

                <a asp-action="Index"
                   asp-route-trangThai="QuaHan"
                   class="btn btn-sm @(trangThaiLoc == "QuaHan" ? "btn-danger" : "btn-outline-danger")">
                    Quá hạn
                </a>

                <a asp-action="Index"
                   asp-route-trangThai="DaTra"
                   class="btn btn-sm @(trangThaiLoc == "DaTra" ? "btn-success" : "btn-outline-success")">
                    Đã trả
                </a>

                <a asp-action="Index"
                   asp-route-trangThai="TuChoi"
                   class="btn btn-sm @(trangThaiLoc == "TuChoi" ? "btn-secondary" : "btn-outline-secondary")">
                    Từ chối
                </a>

            </div>

        </div>
    </div>

    <!-- DANH SÁCH PHIẾU MƯỢN -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-journal-text me-2"></i>
                Danh sách phiếu mượn
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="text-center">Mã phiếu</th>
                            <th>Độc giả</th>
                            <th>Sách</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-center">Ngày mượn</th>
                            <th class="text-center">Hạn trả</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var phieu in Model)
                            {
                                string badgeClass = phieu.TrangThai switch
                                {
                                    "Chờ xác nhận" => "bg-warning text-dark",

                                    "Đang mượn" when phieu.NgayTra == null &&
                                        phieu.HanTra.Date < DateTime.Today => "bg-danger",

                                    "Đang mượn" => "bg-info text-dark",

                                    "Đã trả" => "bg-success",

                                    "Từ chối" => "bg-secondary",

                                    "Đã hủy" => "bg-secondary",

                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <td class="text-center fw-bold">
                                        #@soThuTu
                                    </td>

                                    <td>
                                        @(phieu.DocGia?.HoTen ?? "Chưa có thông tin")
                                    </td>

                                    <td>
                                        @if (phieu.ChiTietPhieuMuons != null &&
                                             phieu.ChiTietPhieuMuons.Any())
                                        {
                                            foreach (var ct in phieu.ChiTietPhieuMuons)
                                            {
                                                <div class="mb-1">
                                                    <i class="bi bi-book me-1"></i>
                                                    @(ct.Sach?.TenSach ?? "Sách không tồn tại")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa có sách
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @(phieu.ChiTietPhieuMuons?.Sum(ct => ct.SoLuongMuon) ?? 0)
                                    </td>

                                    <td class="text-center">
                                        @phieu.NgayMuon.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @phieu.HanTra.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        <span class="badge @badgeClass">
                                            @phieu.TrangThai
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center flex-wrap gap-1">

                                            @if (phieu.TrangThai == "Chờ xác nhận")
                                            {
                                                <form asp-controller="MuonTra"
                                                      asp-action="XacNhan"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận phiếu này?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@phieu.MaPhieuMuon" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            title="Xác nhận">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>

                                                <form asp-controller="MuonTra"
                                                      asp-action="TuChoi"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn từ chối phiếu này không?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@phieu.MaPhieuMuon" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Từ chối phiếu">
                                                        <i class="bi bi-x-lg"></i>
                                                        Từ chối
                                                    </button>
                                                </form>
                                            }

                                            @if (phieu.TrangThai == "Đang mượn")
                                            {
                                                <form asp-controller="MuonTra"
                                                      asp-action="Tra"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận đã nhận lại sách?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@phieu.MaPhieuMuon" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-primary">
                                                        <i class="bi bi-box-arrow-in-left"></i>
                                                        Trả sách
                                                    </button>
                                                </form>
                                            }

                                            @if (phieu.TrangThai == "Đã trả")
                                            {
                                                <span class="text-success small">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Hoàn thành
                                                </span>
                                            }

                                            @if (phieu.TrangThai == "Từ chối")
                                            {
                                                <span class="text-secondary small">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    Đã từ chối
                                                </span>
                                            }

                                            @if (phieu.TrangThai == "Đã hủy")
                                            {
                                                <span class="text-muted small">
                                                    Đã hủy
                                                </span>
                                            }

                                            @if (phieu.TrangThai == "Chờ xác nhận" ||
                                                 phieu.TrangThai == "Từ chối" ||
                                                 phieu.TrangThai == "Đã hủy" ||
                                                 phieu.TrangThai == "Đã trả")
                                            {
                                                <form asp-controller="MuonTra"
                                                      asp-action="Xoa"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu này không? Dữ liệu chi tiết của phiếu cũng sẽ bị xóa.');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@phieu.MaPhieuMuon" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            title="Xóa phiếu">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>

                                soThuTu++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">

                                    <i class="bi bi-inbox fs-1 text-muted"></i>

                                    <p class="text-muted mt-2 mb-0">
                                        Không tìm thấy phiếu mượn nào.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- PHÂN TRANG -->
        @if (tongSoTrang > 1)
        {
            <div class="card-footer bg-white">

                <nav>
                    <ul class="pagination justify-content-center mb-0">

                        <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="MuonTra"
                               asp-action="Index"
                               asp-route-page="@(trangHienTai - 1)"
                               asp-route-trangThai="@trangThaiLoc">
                                Trước
                            </a>

                        </li>

                        @for (int i = 1; i <= tongSoTrang; i++)
                        {
                            <li class="page-item @(i == trangHienTai ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="MuonTra"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-trangThai="@trangThaiLoc">
                                    @i
                                </a>

                            </li>
                        }

                        <li class="page-item @(trangHienTai >= tongSoTrang ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="MuonTra"
                               asp-action="Index"
                               asp-route-page="@(trangHienTai + 1)"
                               asp-route-trangThai="@trangThaiLoc">
                                Sau
                            </a>

                        </li>

                    </ul>
                </nav>

            </div>
        }

    </div>

</div>