@model QuanLyThuVien_UNETI04_TI17A1HN.Models.PhieuMuon

@{
    ViewData["Title"] = "Thêm phiếu mượn";
    var danhSachSach = ViewBag.DanhSachSach as IEnumerable<dynamic>;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">LẬP PHIẾU MƯỢN SÁCH</h2>
            <p class="text-muted mb-0">Thủ thư tạo phiếu mượn sách trực tiếp tại quầy cho độc giả</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-journal-plus me-2"></i>Thông tin phiếu mượn
            </h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="formTaoPhieu">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="MaDocGia" class="form-label fw-bold">
                            Độc giả mượn sách <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaDocGia" class="form-select" asp-items="ViewBag.MaDocGia">
                            <option value="">-- Chọn độc giả --</option>
                        </select>
                        <span asp-validation-for="MaDocGia" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Trạng thái khởi tạo</label>
                        <div>
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                <i class="bi bi-clock-history me-1"></i> Chờ xác nhận
                            </span>
                        </div>
                        <input type="hidden" asp-for="TrangThai" value="Chờ xác nhận" />
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="NgayMuon" class="form-label fw-bold">Ngày mượn</label>
                        <input asp-for="NgayMuon" type="date" class="form-control" />
                        <span asp-validation-for="NgayMuon" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HanTra" class="form-label fw-bold">Hạn trả <span class="text-danger">*</span></label>
                        <input asp-for="HanTra" type="date" class="form-control" />
                        <span asp-validation-for="HanTra" class="text-danger"></span>
                        <small class="text-muted">Mặc định: 14 ngày kể từ ngày lập phiếu.</small>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Danh sách sách mượn (Mượn 1 hoặc nhiều sách) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-bookshelf me-2"></i>Danh sách sách mượn
                            </h5>
                            <small class="text-muted">Độc giả có thể mượn một hoặc nhiều cuốn sách trong cùng một phiếu (tối đa 5 quyển).</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success" id="btnThemSach">
                            <i class="bi bi-plus-circle me-1"></i> + Thêm sách mượn
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="bangSachMuon">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên sách cần mượn <span class="text-danger">*</span></th>
                                    <th style="width: 170px;" class="text-center">Số lượng mượn</th>
                                    <th style="width: 90px;" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachSachBody">
                                <!-- Dòng sách đầu tiên mặc định -->
                                <tr class="dong-sach">
                                    <td>
                                        <select name="danhSachMaSach" class="form-select select-sach" required>
                                            <option value="">-- Chọn sách cần mượn --</option>
                                            @if (danhSachSach != null)
                                            {
                                                foreach (var s in danhSachSach)
                                                {
                                                    <option value="@s.MaSach">@s.TenHienThi</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="danhSachSoLuong" class="form-control text-center" value="1" min="1" max="5" required />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-xoa-dong" title="Xóa dòng này" disabled>
                                            Xóa
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Tạo phiếu mượn
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-3">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var btnThem = document.getElementById('btnThemSach');
            var tbody = document.getElementById('danhSachSachBody');

            // Thêm dòng sách mới
            btnThem.addEventListener('click', function () {
                var firstRow = tbody.querySelector('.dong-sach');
                if (!firstRow) return;

                var newRow = firstRow.cloneNode(true);

                // Reset giá trị trên dòng mới
                var select = newRow.querySelector('select');
                if (select) select.value = '';

                var input = newRow.querySelector('input[type="number"]');
                if (input) input.value = '1';

                tbody.appendChild(newRow);
                capNhatTrangThaiNutXoa();
            });

            // Xóa dòng sách
            tbody.addEventListener('click', function (e) {
                var btnXoa = e.target.closest('.btn-xoa-dong');
                if (!btnXoa) return;

                var rows = tbody.querySelectorAll('.dong-sach');
                if (rows.length > 1) {
                    var row = btnXoa.closest('.dong-sach');
                    if (row) {
                        row.remove();
                        capNhatTrangThaiNutXoa();
                    }
                }
            });

            function capNhatTrangThaiNutXoa() {
                var rows = tbody.querySelectorAll('.dong-sach');
                rows.forEach(function (r) {
                    var btn = r.querySelector('.btn-xoa-dong');
                    if (btn) {
                        if (rows.length === 1) {
                            btn.setAttribute('disabled', 'disabled');
                        } else {
                            btn.removeAttribute('disabled');
                        }
                    }
                });
            }
        });
    </script>
}
