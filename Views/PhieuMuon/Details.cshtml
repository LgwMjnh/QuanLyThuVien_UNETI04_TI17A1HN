@using QuanLyThuVien_UNETI04_TI17A1HN.Helpers
@model QuanLyThuVien_UNETI04_TI17A1HN.Models.PhieuMuon

@{
    ViewData["Title"] = "Chi tiết phiếu mượn";
    var quaHan = Model.TrangThai == "Đang mượn"
        && DateTime.Today > Model.HanTra.Date;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary">CHI TIẾT PHIẾU MƯỢN #@Model.MaPhieuMuon</h2>
            <p class="text-muted mb-0">Thông tin phiếu mượn và danh sách các cuốn sách trong phiếu</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-2 text-muted">Mã phiếu mượn</dt>
                <dd class="col-sm-4 fw-bold">#@Model.MaPhieuMuon</dd>

                <dt class="col-sm-2 text-muted">Độc giả mượn</dt>
                <dd class="col-sm-4 fw-bold text-primary">
                    @(Model.DocGia?.HoTen ?? ("Độc giả #" + Model.MaDocGia))
                    @if (Model.DocGia != null)
                    {
                        <span class="badge bg-light text-dark border ms-1">@Model.DocGia.MaHienThi</span>
                    }
                </dd>

                <dt class="col-sm-2 text-muted">Ngày mượn</dt>
                <dd class="col-sm-4">@Model.NgayMuon.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-2 text-muted">Hạn trả</dt>
                <dd class="col-sm-4">
                    @Model.HanTra.ToString("dd/MM/yyyy")
                    @if (quaHan)
                    {
                        <span class="badge bg-danger ms-1">Quá hạn</span>
                    }
                </dd>

                <dt class="col-sm-2 text-muted">Trạng thái phiếu</dt>
                <dd class="col-sm-10">
                    @if (Model.TrangThai == "Chờ xác nhận")
                    {
                        <span class="badge bg-warning text-dark fs-6">Chờ xác nhận</span>
                    }
                    else if (Model.TrangThai == "Đang mượn")
                    {
                        <span class="badge bg-primary fs-6">Đang mượn</span>
                    }
                    else if (Model.TrangThai == "Đã trả")
                    {
                        <span class="badge bg-success fs-6">Đã trả</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">@Model.TrangThai</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-bookshelf me-2"></i>Danh sách sách trong phiếu mượn
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Tên sách</th>
                            <th>Thể loại</th>
                            <th class="text-center" style="width: 140px;">Số lượng mượn</th>
                            <th>Ngày trả thực tế</th>
                            <th>Tình trạng trả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ChiTietPhieuMuons == null || !Model.ChiTietPhieuMuons.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    Chưa có chi tiết sách cho phiếu này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ct in Model.ChiTietPhieuMuons)
                            {
                                <tr>
                                    <td class="fw-bold">@(ct.Sach?.TenSach ?? ("Sách #" + ct.MaSach))</td>
                                    <td>@(ct.Sach?.TheLoai?.TenTheLoai ?? "-")</td>
                                    <td class="text-center">@ct.SoLuongMuon</td>
                                    <td>@(ct.NgayTra?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@(ct.TinhTrangTra ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
