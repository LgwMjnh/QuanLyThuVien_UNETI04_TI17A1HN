@model QuanLyThuVien_UNETI04_TI17A1HN.Models.DangKyMuonViewModel

@{
    ViewData["Title"] = "Đăng ký mượn sách";
}

<h1>Đăng ký mượn sách</h1>
<p class="text-muted">Yêu cầu sẽ ở trạng thái <strong>Chờ xác nhận</strong> cho đến khi quản trị viên duyệt (Module 4).</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="DangKy" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MaSach" class="form-label"></label>
                <select asp-for="MaSach" class="form-select" asp-items="ViewBag.MaSach">
                    <option value="">-- Chọn sách đang phục vụ --</option>
                </select>
                <span asp-validation-for="MaSach" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoLuongMuon" class="form-label"></label>
                <input asp-for="SoLuongMuon" type="number" min="1" class="form-control" />
                <span asp-validation-for="SoLuongMuon" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HanTra" class="form-label"></label>
                <input asp-for="HanTra" type="date" class="form-control" />
                <span asp-validation-for="HanTra" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Gửi yêu cầu mượn</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Phiếu của tôi</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
