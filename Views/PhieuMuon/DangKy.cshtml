@model QuanLyThuVien_UNETI04_TI17A1HN.Models.DangKyMuonViewModel

@{
    ViewData["Title"] = "Đăng ký mượn sách";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-journal-plus me-2"></i>ĐĂNG KÝ MƯỢN SÁCH TRỰC TUYẾN
                    </h4>
                    <small>Yêu cầu sẽ ở trạng thái <strong>Chờ xác nhận</strong> cho đến khi thủ thư phê duyệt.</small>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.TenDocGia != null)
                    {
                        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                            <div>
                                <i class="bi bi-person-check-fill fs-5 me-2"></i>
                                Đang đăng ký cho độc giả: <strong>@ViewBag.TenDocGia</strong>
                                <span class="badge bg-secondary ms-2">Mã độc giả: #@ViewBag.MaDocGia</span>
                            </div>
                        </div>
                    }

                    <form asp-controller="PhieuMuon" asp-action="DangKy" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="MaSach" class="form-label fw-bold">
                                Chọn sách cần mượn <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MaSach" class="form-select" asp-items="ViewBag.MaSach">
                                <option value="">-- Chọn đầu sách đang phục vụ trong thư viện --</option>
                            </select>
                            <span asp-validation-for="MaSach" class="text-danger"></span>
                            <small class="text-muted d-block mt-1">
                                Danh sách chỉ hiển thị các đầu sách còn trong kho và đang ở trạng thái phục vụ.
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoLuongMuon" class="form-label fw-bold">
                                    Số lượng mượn <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SoLuongMuon" type="number" min="1" max="100" class="form-control" />
                                <span asp-validation-for="SoLuongMuon" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HanTra" class="form-label fw-bold">
                                    Hạn trả dự kiến <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HanTra" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                                <span asp-validation-for="HanTra" class="text-danger"></span>
                                <small class="text-muted d-block mt-1">Mặc định là 14 ngày tính từ hôm nay.</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Xem phiếu mượn của tôi
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                Gửi yêu cầu mượn sách
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
