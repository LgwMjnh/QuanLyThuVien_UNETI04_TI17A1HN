@model QuanLyThuVien_UNETI04_TI17A1HN.Models.DangKyMuonViewModel

@{
    ViewData["Title"] = "Đăng ký mượn sách";
    var danhSachSach = ViewBag.DanhSachSach as IEnumerable<dynamic>;
}

<style>
    .table-responsive {
        overflow: visible !important;
    }
    .custom-search-select {
        position: relative;
    }
    .custom-search-select .form-select {
        cursor: pointer;
        background-color: #fff;
        padding-right: 2.25rem;
    }
    .custom-search-select .form-select.is-invalid {
        border-color: #dc3545 !important;
    }
    .custom-search-select .dropdown-menu {
        border-radius: 8px;
        border: 1px solid #dee2e6;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        z-index: 1055;
    }
    .custom-search-select .options-list {
        max-height: 240px;
        overflow-y: auto;
        padding-right: 4px;
    }
    .custom-search-select .options-list::-webkit-scrollbar {
        width: 6px;
    }
    .custom-search-select .options-list::-webkit-scrollbar-thumb {
        background-color: #ced4da;
        border-radius: 4px;
    }
    .custom-search-select .dropdown-item {
        font-size: 0.9rem;
        cursor: pointer;
        white-space: normal;
        padding: 8px 12px;
        border-radius: 6px;
        margin-bottom: 2px;
        line-height: 1.4;
    }
    .custom-search-select .dropdown-item:hover,
    .custom-search-select .dropdown-item:focus {
        background-color: #e9f2ff;
        color: #0d6efd;
    }
    .custom-search-select .dropdown-item.active {
        background-color: #0d6efd !important;
        color: #ffffff !important;
        font-weight: 600;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-journal-plus me-2"></i>ĐĂNG KÝ MƯỢN SÁCH TRỰC TUYẾN
                    </h4>
                    <small>Yêu cầu sẽ ở trạng thái <strong>Chờ xác nhận</strong> cho đến khi thủ thư phê duyệt tại quầy.</small>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.TenDocGia != null)
                    {
                        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                            <div>
                                <i class="bi bi-person-check-fill fs-5 me-2"></i>
                                Đang đăng ký cho độc giả: <strong>@ViewBag.TenDocGia</strong>
                                <span class="badge bg-secondary ms-2">Mã độc giả: @(ViewBag.MaHienThi ?? ("#" + ViewBag.MaDocGia))</span>
                            </div>
                        </div>
                    }

                    <form asp-controller="PhieuMuon" asp-action="DangKy" method="post" id="formDangKy">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Trạng thái khởi tạo</label>
                                <div>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i> Chờ xác nhận
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="HanTra" class="form-label fw-bold">
                                    Hạn trả dự kiến <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HanTra" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                                <span asp-validation-for="HanTra" class="text-danger"></span>
                                <small class="text-muted d-block mt-1">Mặc định: 14 ngày kể từ hôm nay.</small>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Danh sách sách mượn (Mượn 1 hoặc nhiều sách) -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">
                                        <i class="bi bi-bookshelf me-2"></i>Danh sách sách đăng ký mượn
                                    </h5>
                                    <small class="text-muted">Bạn có thể chọn một hoặc nhiều cuốn sách khác nhau (tổng tối đa 5 quyển).</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-success" id="btnThemSach">
                                    <i class="bi bi-plus-circle me-1"></i> + Thêm sách mượn
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered align-middle" id="bangSachMuon">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tên sách cần mượn <span class="text-danger">*</span></th>
                                            <th style="width: 170px;" class="text-center">Số lượng</th>
                                            <th style="width: 90px;" class="text-center">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="danhSachSachBody">
                                        <!-- Dòng sách đầu tiên mặc định -->
                                        <tr class="dong-sach">
                                            <td>
                                                <select name="danhSachMaSach" class="form-select select-sach" required>
                                                    <option value="">-- Chọn đầu sách đang phục vụ --</option>
                                                    @if (danhSachSach != null)
                                                    {
                                                        foreach (var s in danhSachSach)
                                                        {
                                                            <option value="@s.MaSach" selected="@(Model.MaSach.HasValue && Model.MaSach.Value == s.MaSach)">
                                                                @s.TenHienThi
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" name="danhSachSoLuong" class="form-control text-center" value="1" min="1" max="5" required />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm btn-xoa-dong" title="Xóa dòng này" disabled>
                                                    Xóa
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-card-list me-1"></i> Xem phiếu mượn của tôi
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                <i class="bi bi-send me-1"></i> Gửi yêu cầu mượn sách
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        function removeVietnameseTones(str) {
            if (!str) return '';
            return str.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd').replace(/Đ/g, 'D');
        }

        function initSearchableSelect(selectEl, placeholder) {
            if (!selectEl || selectEl.dataset.searchableInit === 'true') return;
            selectEl.dataset.searchableInit = 'true';
            selectEl.removeAttribute('required');
            selectEl.classList.add('d-none');

            var wrapper = document.createElement('div');
            wrapper.className = 'dropdown custom-search-select position-relative w-100';

            var toggleBtn = document.createElement('button');
            toggleBtn.type = 'button';
            toggleBtn.className = 'form-select text-start d-flex justify-content-between align-items-center';
            toggleBtn.setAttribute('data-bs-toggle', 'dropdown');
            toggleBtn.setAttribute('data-bs-auto-close', 'outside');
            toggleBtn.setAttribute('aria-expanded', 'false');

            var textSpan = document.createElement('span');
            textSpan.className = 'text-truncate me-2 selected-label';

            var selectedOpt = selectEl.options[selectEl.selectedIndex];
            var defaultPlaceholder = placeholder || '-- Chọn --';
            if (selectedOpt && selectedOpt.value) {
                textSpan.textContent = selectedOpt.text;
            } else {
                textSpan.textContent = defaultPlaceholder;
                textSpan.classList.add('text-muted');
            }

            toggleBtn.appendChild(textSpan);
            wrapper.appendChild(toggleBtn);

            var menu = document.createElement('div');
            menu.className = 'dropdown-menu w-100 p-2 shadow border';
            menu.style.minWidth = '280px';

            var searchBox = document.createElement('div');
            searchBox.className = 'mb-2';
            searchBox.innerHTML = `
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0 search-input" placeholder="Gõ để tìm kiếm..." autocomplete="off">
                    <button type="button" class="btn btn-outline-secondary btn-clear-search d-none">&times;</button>
                </div>
            `;
            menu.appendChild(searchBox);

            var searchInput = searchBox.querySelector('.search-input');
            var btnClear = searchBox.querySelector('.btn-clear-search');

            var listContainer = document.createElement('div');
            listContainer.className = 'options-list';

            function buildOptions() {
                listContainer.innerHTML = '';
                var curVal = selectEl.value;

                Array.from(selectEl.options).forEach(function (opt) {
                    var item = document.createElement('a');
                    item.className = 'dropdown-item rounded py-1 px-2 mb-1';
                    item.href = 'javascript:void(0);';
                    item.dataset.value = opt.value;
                    item.textContent = opt.text;

                    if (!opt.value) {
                        item.classList.add('text-muted', 'fst-italic');
                    }
                    if (opt.value && opt.value === curVal) {
                        item.classList.add('active');
                    }

                    item.addEventListener('click', function (e) {
                        e.preventDefault();
                        selectOption(opt.value, opt.text);
                    });

                    listContainer.appendChild(item);
                });

                var noResult = document.createElement('div');
                noResult.className = 'text-center text-muted py-2 no-result-msg d-none';
                noResult.innerHTML = '<small><i class="bi bi-info-circle me-1"></i>Không tìm thấy kết quả phù hợp</small>';
                listContainer.appendChild(noResult);
            }

            buildOptions();
            menu.appendChild(listContainer);
            wrapper.appendChild(menu);

            selectEl.parentNode.insertBefore(wrapper, selectEl.nextSibling);

            function selectOption(val, text) {
                selectEl.value = val;
                textSpan.textContent = val ? text : defaultPlaceholder;
                if (val) {
                    textSpan.classList.remove('text-muted');
                    toggleBtn.classList.remove('border-danger', 'is-invalid');
                } else {
                    textSpan.classList.add('text-muted');
                }

                listContainer.querySelectorAll('.dropdown-item').forEach(function (it) {
                    if (it.dataset.value === val && val !== '') {
                        it.classList.add('active');
                    } else {
                        it.classList.remove('active');
                    }
                });

                selectEl.dispatchEvent(new Event('change', { bubbles: true }));

                var bsDropdown = bootstrap.Dropdown.getInstance(toggleBtn);
                if (bsDropdown) bsDropdown.hide();
            }

            function filterOptions() {
                var query = searchInput.value.trim();
                var qRaw = query.toLowerCase();
                var qNorm = removeVietnameseTones(query);

                if (query) {
                    btnClear.classList.remove('d-none');
                } else {
                    btnClear.classList.add('d-none');
                }

                var items = listContainer.querySelectorAll('.dropdown-item');
                var visibleCount = 0;

                items.forEach(function (item) {
                    var text = item.textContent;
                    var tRaw = text.toLowerCase();
                    var tNorm = removeVietnameseTones(text);

                    if (!query || tRaw.includes(qRaw) || tNorm.includes(qNorm)) {
                        item.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                var noResult = listContainer.querySelector('.no-result-msg');
                if (noResult) {
                    if (visibleCount === 0) {
                        noResult.classList.remove('d-none');
                    } else {
                        noResult.classList.add('d-none');
                    }
                }
            }

            searchBox.addEventListener('click', function (e) {
                e.stopPropagation();
            });

            searchInput.addEventListener('input', filterOptions);

            btnClear.addEventListener('click', function (e) {
                e.stopPropagation();
                searchInput.value = '';
                filterOptions();
                searchInput.focus();
            });

            searchInput.addEventListener('keydown', function (e) {
                e.stopPropagation();
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var first = listContainer.querySelector('.dropdown-item:not(.d-none)');
                    if (first) first.focus();
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    var first = listContainer.querySelector('.dropdown-item:not(.d-none)');
                    if (first) first.click();
                } else if (e.key === 'Escape') {
                    var bsDropdown = bootstrap.Dropdown.getInstance(toggleBtn);
                    if (bsDropdown) bsDropdown.hide();
                }
            });

            toggleBtn.addEventListener('shown.bs.dropdown', function () {
                searchInput.focus();
                searchInput.select();
            });

            toggleBtn.addEventListener('hidden.bs.dropdown', function () {
                searchInput.value = '';
                filterOptions();
            });

            selectEl.addEventListener('change', function () {
                var opt = selectEl.options[selectEl.selectedIndex];
                if (opt && opt.value) {
                    textSpan.textContent = opt.text;
                    textSpan.classList.remove('text-muted');
                    toggleBtn.classList.remove('border-danger', 'is-invalid');
                } else {
                    textSpan.textContent = defaultPlaceholder;
                    textSpan.classList.add('text-muted');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var btnThem = document.getElementById('btnThemSach');
            var tbody = document.getElementById('danhSachSachBody');
            var form = document.getElementById('formDangKy');

            // Lưu mẫu HTML option sách để dùng khi thêm dòng
            var firstSelectSach = tbody.querySelector('select.select-sach');
            var optionsSachHtml = firstSelectSach ? firstSelectSach.innerHTML : '';

            // 1. Khởi tạo tìm kiếm cho dòng sách đầu tiên
            if (firstSelectSach) {
                initSearchableSelect(firstSelectSach, '-- Chọn đầu sách đang phục vụ --');
            }

            // 2. Thêm dòng sách mới
            btnThem.addEventListener('click', function () {
                var rows = tbody.querySelectorAll('.dong-sach');
                if (rows.length >= 5) {
                    alert('Bạn chỉ có thể đăng ký mượn tối đa 5 cuốn sách!');
                    return;
                }

                var newRow = document.createElement('tr');
                newRow.className = 'dong-sach';
                newRow.innerHTML = `
                    <td>
                        <select name="danhSachMaSach" class="form-select select-sach" required>
                            ${optionsSachHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" name="danhSachSoLuong" class="form-control text-center" value="1" min="1" max="5" required />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm btn-xoa-dong" title="Xóa dòng này">
                            Xóa
                        </button>
                    </td>
                `;

                tbody.appendChild(newRow);

                var newSelect = newRow.querySelector('select.select-sach');
                newSelect.value = '';
                initSearchableSelect(newSelect, '-- Chọn đầu sách đang phục vụ --');

                capNhatTrangThaiNutXoa();
            });

            // 3. Xóa dòng sách
            tbody.addEventListener('click', function (e) {
                var btnXoa = e.target.closest('.btn-xoa-dong');
                if (!btnXoa) return;

                var rows = tbody.querySelectorAll('.dong-sach');
                if (rows.length > 1) {
                    var row = btnXoa.closest('.dong-sach');
                    if (row) {
                        row.remove();
                        capNhatTrangThaiNutXoa();
                    }
                }
            });

            function capNhatTrangThaiNutXoa() {
                var rows = tbody.querySelectorAll('.dong-sach');
                rows.forEach(function (r) {
                    var btn = r.querySelector('.btn-xoa-dong');
                    if (btn) {
                        if (rows.length === 1) {
                            btn.setAttribute('disabled', 'disabled');
                        } else {
                            btn.removeAttribute('disabled');
                        }
                    }
                });
            }

            // 4. Kiểm tra trùng sách giữa các dòng
            tbody.addEventListener('change', function (e) {
                if (e.target && e.target.classList.contains('select-sach')) {
                    var selected = [];
                    var duplicate = false;
                    tbody.querySelectorAll('select.select-sach').forEach(function (sel) {
                        if (sel.value) {
                            if (selected.includes(sel.value)) {
                                duplicate = true;
                                sel.value = '';
                                sel.dispatchEvent(new Event('change'));
                            } else {
                                selected.push(sel.value);
                            }
                        }
                    });
                    if (duplicate) {
                        alert('Cuốn sách này đã được bạn chọn ở một dòng khác. Vui lòng chọn sách khác hoặc điều chỉnh số lượng mượn!');
                    }
                }
            });

            // 5. Kiểm tra hợp lệ trước khi submit form
            if (form) {
                form.addEventListener('submit', function (e) {
                    var hopLe = true;

                    var selects = tbody.querySelectorAll('select.select-sach');
                    selects.forEach(function (sel) {
                        if (!sel.value) {
                            var wrapper = sel.nextElementSibling;
                            var btn = wrapper ? wrapper.querySelector('.form-select') : null;
                            if (btn) btn.classList.add('border-danger', 'is-invalid');
                            hopLe = false;
                        }
                    });

                    if (!hopLe) {
                        e.preventDefault();
                        alert('Vui lòng chọn đầu sách cần mượn trước khi gửi yêu cầu!');
                    }
                });
            }
        });
    </script>
}
