@model QuanLyThuVien_UNETI04_TI17A1HN.Models.DocGia

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge me-2"></i>THÔNG TIN CÁ NHÂN ĐỘC GIẢ
                    </h4>
                    <small>Độc giả có thể chủ động cập nhật các thông tin liên lạc cá nhân.</small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="HoSo" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mã độc giả</label>
                                <input class="form-control bg-light fw-bold text-primary" value="@Model.MaHienThi" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tên đăng nhập</label>
                                <input class="form-control bg-light" value="@(Model.TaiKhoan?.TenDangNhap ?? "-")" disabled />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label fw-bold">
                                Họ và tên <span class="text-danger">*</span>
                            </label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="NgaySinh" class="form-label fw-bold">Ngày sinh</label>
                                <input asp-for="NgaySinh" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                                <span asp-validation-for="NgaySinh" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="GioiTinh" class="form-label fw-bold">Giới tính</label>
                                <select asp-for="GioiTinh" class="form-select">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="GioiTinh" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0912345678" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: docgia@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ</label>
                            <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Nhập địa chỉ cư trú..."></textarea>
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ngày đăng ký thẻ</label>
                                <input class="form-control bg-light" value="@Model.NgayDangKy.ToString("dd/MM/yyyy")" disabled />
                                <small class="text-muted">Do hệ thống quản lý, không được chỉnh sửa.</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Trạng thái thẻ</label>
                                <div>
                                    @if (Model.TrangThai == "Hoạt động")
                                    {
                                        <span class="badge bg-success fs-6">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6">@Model.TrangThai</span>
                                    }
                                </div>
                                <small class="text-muted">Do thủ thư thư viện quản lý.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="PhieuMuon" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-clock-history me-1"></i> Xem lịch sử mượn sách
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                <i class="bi bi-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
