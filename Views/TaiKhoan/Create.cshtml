
@model QuanLyThuVien_UNETI04_TI17A1HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 600px;">

        <div class="mb-4">
            <h1 class="mb-1">Thêm tài khoản</h1>
            <p class="text-muted mb-0">
                Nhập thông tin để tạo tài khoản mới trong hệ thống thư viện
            </p>
        </div>

        <div class="card">
            <div class="card-header py-3">
                Thông tin tài khoản
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label">
                            Tên đăng nhập
                        </label>
                        <input asp-for="TenDangNhap"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập" />
                        <span asp-validation-for="TenDangNhap"
                              class="text-danger">
                        </span>
                    </div>

                                        <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label">
                            Mật khẩu
                        </label>

                        <div class="pass-box">
                            <input asp-for="MatKhau"
                                   type="password"
                                   id="MatKhau"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu" />

                            <button type="button"
                                    class="pass-btn"
                                    onclick="togglePassword('MatKhau', this)">
                                Hiện
                            </button>
                        </div>

                        <span asp-validation-for="MatKhau"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label">
                            Họ và tên
                        </label>
                        <input asp-for="HoTen"
                               class="form-control"
                               placeholder="Nhập họ và tên" />
                        <span asp-validation-for="HoTen"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VaiTro" class="form-label">
                            Vai trò
                        </label>
                        <select asp-for="VaiTro" class="form-select">
                            <option value="">-- Chọn vai trò --</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                            <option value="DocGia">Độc giả</option>
                        </select>
                        <span asp-validation-for="VaiTro"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Thêm tài khoản
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Quay lại danh sách
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
