@model QuanLyThuVien_UNETI04_TI17A1HN.ViewModels.TaiKhoanTaoViewModel

@{
    ViewData["Title"] = "Thêm tài khoản";
    bool laKhoiTao = ViewData["LaKhoiTao"] as bool? ?? false;
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <h1 class="mb-1">Thêm tài khoản</h1>
            <p class="text-muted mb-0">
                Nhập thông tin để tạo tài khoản mới trong hệ thống thư viện
            </p>
        </div>

        <div class="card">
            <div class="card-header py-3">
                Thông tin tài khoản
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label">
                            Tên đăng nhập
                        </label>

                        <input asp-for="TenDangNhap"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập" />

                        <span asp-validation-for="TenDangNhap"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label">
                            Mật khẩu
                        </label>

                        <div class="pass-box">
                            <input asp-for="MatKhau"
                                   type="password"
                                   id="MatKhau"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu" />

                            <button type="button"
                                    class="pass-btn"
                                    onclick="togglePassword('MatKhau', this)">
                                Hiện
                            </button>
                        </div>

                        <span asp-validation-for="MatKhau"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label">
                            Họ và tên
                        </label>

                        <input asp-for="HoTen"
                               class="form-control"
                               placeholder="Nhập họ và tên" />

                        <span asp-validation-for="HoTen"
                              class="text-danger"></span>
                    </div>

                    <hr />

                    @if (laKhoiTao)
                    {
                        <div class="alert alert-warning">
                            <strong>Thiết lập Admin đầu tiên</strong>
                            <p class="mb-0 mt-1">
                                Hệ thống chưa có tài khoản Admin.
                                Bạn cần nhập mã bảo mật để tạo Admin đầu tiên.
                            </p>
                        </div>

                        <div class="form-check mb-3">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked
                                   disabled />

                            <label class="form-check-label">
                                Tạo tài khoản Admin
                            </label>

                            <input type="hidden"
                                   name="TaoAdmin"
                                   value="true" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaBaoMat" class="form-label">
                                Mã bảo mật
                            </label>

                            <input asp-for="MaBaoMat"
                                   type="password"
                                   class="form-control"
                                   placeholder="Nhập mã bảo mật Admin đầu tiên" />

                            <span asp-validation-for="MaBaoMat"
                                  class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <div class="form-check mb-3">
                            <input asp-for="TaoAdmin"
                                   class="form-check-input"
                                   id="TaoAdmin" />

                            <label asp-for="TaoAdmin"
                                   class="form-check-label">
                                Tạo tài khoản Admin
                            </label>
                        </div>

                        <div class="alert alert-info">
                            <strong>Tích chọn để tạo tài khoản quản trị viên</strong>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Thêm tài khoản
                        </button>

                        @if (!laKhoiTao)
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Quay lại danh sách
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}