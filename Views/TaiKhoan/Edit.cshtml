@model QuanLyThuVien_UNETI04_TI17A1HN.ViewModels.TaiKhoanSuaViewModel

@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="container py-4">
    <div class="mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <h1 class="mb-1">Sửa tài khoản</h1>
            <p class="text-muted mb-0">
                Cập nhật thông tin tài khoản
            </p>
        </div>

        <div class="card">
            <div class="card-header py-3">
                Thông tin tài khoản
            </div>

            <div class="card-body">
                <form asp-action="Edit"
                      asp-route-mataikhoan="@Model.MaTaiKhoan"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="MaTaiKhoan" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label">
                            Tên đăng nhập
                        </label>

                        <input asp-for="TenDangNhap"
                               class="form-control" />

                        <span asp-validation-for="TenDangNhap"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label">
                            Họ và tên
                        </label>

                        <input asp-for="HoTen"
                               class="form-control" />

                        <span asp-validation-for="HoTen"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TrangThai" class="form-label">
                            Trạng thái tài khoản
                        </label>

                        <select asp-for="TrangThai" class="form-select">
                            <option value="0">Bình thường</option>
                            <option value="1">Bị khóa</option>
                            <option value="2">Bị ban</option>
                        </select>

                        <span asp-validation-for="TrangThai"
                              class="text-danger"></span>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label asp-for="MatKhauMoi" class="form-label">
                            Mật khẩu mới
                        </label>

                        <input asp-for="MatKhauMoi"
                               type="password"
                               class="form-control"
                               placeholder="Để trống nếu không đổi mật khẩu" />

                        <span asp-validation-for="MatKhauMoi"
                              class="text-danger"></span>

                        <small class="text-muted">
                            Mật khẩu mới phải từ 6 đến 20 ký tự.
                        </small>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Lưu thay đổi
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}