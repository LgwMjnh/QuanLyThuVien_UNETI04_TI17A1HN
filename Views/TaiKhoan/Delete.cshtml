@model QuanLyThuVien_UNETI04_TI17A1HN.Models.TaiKhoan

@using QuanLyThuVien_UNETI04_TI17A1HN.Models

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="mb-1">Xóa tài khoản</h1>
        <p class="text-muted mb-0">
            Xác nhận trước khi xóa tài khoản khỏi hệ thống thư viện
        </p>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Thông tin tài khoản
        </div>

        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <strong>Lưu ý:</strong>
                Bạn có chắc chắn muốn xóa tài khoản này không?
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 mb-3">Tên đăng nhập</dt>
                <dd class="col-sm-9 mb-3">
                    @Html.DisplayFor(model => model.TenDangNhap)
                </dd>

                <dt class="col-sm-3 mb-3">Họ và tên</dt>
                <dd class="col-sm-9 mb-3">
                    @Html.DisplayFor(model => model.HoTen)
                </dd>

                <dt class="col-sm-3 mb-3">Vai trò</dt>
                <dd class="col-sm-9 mb-3">
                    @(Model.VaiTro == "DocGia" ? "Độc giả" :
                      Model.VaiTro == "Admin" ? "Admin" : Model.VaiTro)
                </dd>

                <dt class="col-sm-3 mb-3">Trạng thái</dt>
                <dd class="col-sm-9 mb-3">
                    @if (Model.TrangThai == TrangThaiTaiKhoan.BinhThuong)
                    {
                        <span class="badge bg-success">Bình thường</span>
                    }
                    else if (Model.TrangThai == TrangThaiTaiKhoan.BiKhoa)
                    {
                        <span class="badge bg-warning text-dark">Bị khóa</span>
                    }
                    else if (Model.TrangThai == TrangThaiTaiKhoan.BiBan)
                    {
                        <span class="badge bg-danger">Bị ban</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Không xác định</span>
                    }
                </dd>

                <dt class="col-sm-3 mb-3">Số lần đăng nhập sai</dt>
                <dd class="col-sm-9 mb-3">
                    @Model.SoLanDangNhapSai lần
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex flex-wrap gap-2">
            <form asp-action="Delete"
                  method="post"
                  onsubmit="return confirm('Bạn có muốn xóa tài khoản này không?');">
                <input type="hidden" asp-for="MaTaiKhoan" />

                <button type="submit" class="btn btn-danger">
                    Xóa tài khoản
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>