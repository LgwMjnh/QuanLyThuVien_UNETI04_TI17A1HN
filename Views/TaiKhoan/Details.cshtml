
@model QuanLyThuVien_UNETI04_TI17A1HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="mb-1">Chi tiết tài khoản</h1>
        <p class="text-muted mb-0">
            Thông tin chi tiết của tài khoản trong hệ thống thư viện
        </p>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Thông tin tài khoản
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 mb-3">Tên đăng nhập</dt>
                <dd class="col-sm-9 mb-3">
                    @Html.DisplayFor(model => model.TenDangNhap)
                </dd>

                <dt class="col-sm-3 mb-3">Họ và tên</dt>
                <dd class="col-sm-9 mb-3">
                    @Html.DisplayFor(model => model.HoTen)
                </dd>

                <dt class="col-sm-3 mb-3">Vai trò</dt>
                <dd class="col-sm-9 mb-3">
                    @(Model.VaiTro == "DocGia" ? "Độc giả" :
                      Model.VaiTro == "Admin" ? "Admin" : Model.VaiTro)
                </dd>

                <dt class="col-sm-3 mb-3">Trạng thái</dt>
                <dd class="col-sm-9 mb-3">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã khóa</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex flex-wrap gap-2">
            <a asp-action="Edit"
               asp-route-mataikhoan="@Model.MaTaiKhoan"
               class="btn btn-primary">
                Sửa tài khoản
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
