 @model IEnumerable<QuanLyThuVien_UNETI04_TI17A1HN.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Quản lý tài khoản</h1>
            <p class="text-muted mb-0">Danh sách tài khoản trong hệ thống thư viện</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm tài khoản
        </a>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Danh sách tài khoản
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tên đăng nhập</th>
                            <th>Họ và tên</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TenDangNhap</td>
                                <td>@item.HoTen</td>
                                <td>
                                    @(item.VaiTro == "DocGia" ? "Độc giả" :
                                      item.VaiTro == "Admin" ? "Admin" : item.VaiTro)
                                </td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-mataikhoan="@item.MaTaiKhoan"
                                       class="btn btn-sm btn-outline-primary">
                                        Chi tiết
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-mataikhoan="@item.MaTaiKhoan"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-mataikhoan="@item.MaTaiKhoan"
                                       class="btn btn-sm btn-outline-danger">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-center text-muted py-4 mb-0">
                    Chưa có tài khoản nào trong hệ thống.
                </p>
            }
        </div>
    </div>
</div>