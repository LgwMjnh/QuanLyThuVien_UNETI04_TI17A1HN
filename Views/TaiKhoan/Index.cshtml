@model IEnumerable<QuanLyThuVien_UNETI04_TI17A1HN.Models.TaiKhoan>

@using QuanLyThuVien_UNETI04_TI17A1HN.Models

@{
    ViewData["Title"] = "Quản lý tài khoản";

    var trangThaiLoc = Context.Request.Query["trangThai"].ToString();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Quản lý tài khoản</h1>
            <p class="text-muted mb-0">
                Danh sách tài khoản trong hệ thống thư viện
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm tài khoản
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row align-items-end g-3">
                    <div class="col-md-5">
                        <label class="form-label">Lọc theo trạng thái</label>

                        <select name="trangThai" class="form-select">
                            <option value=""
                                    selected="@(string.IsNullOrEmpty(trangThaiLoc))">
                                Tất cả tài khoản
                            </option>

                            <option value="0"
                                    selected="@(trangThaiLoc == "0")">
                                Bình thường
                            </option>

                            <option value="1"
                                    selected="@(trangThaiLoc == "1")">
                                Bị khóa
                            </option>

                            <option value="2"
                                    selected="@(trangThaiLoc == "2")">
                                Bị ban
                            </option>
                        </select>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            Lọc
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Làm mới
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Danh sách tài khoản
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-center text-muted py-4 mb-0">
                    Chưa có tài khoản nào trong hệ thống.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Tên đăng nhập</th>
                                <th>Họ và tên</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TenDangNhap</td>

                                    <td>@item.HoTen</td>

                                    <td>
                                        @(item.VaiTro == "DocGia" ? "Độc giả" :
                                          item.VaiTro == "Admin" ? "Admin" : item.VaiTro)
                                    </td>

                                    <td>
                                        @if (item.TrangThai == TrangThaiTaiKhoan.BinhThuong)
                                        {
                                            <span class="badge bg-success">
                                                Bình thường
                                            </span>
                                        }
                                        else if (item.TrangThai == TrangThaiTaiKhoan.BiKhoa)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Bị khóa
                                            </span>
                                        }
                                        else if (item.TrangThai == TrangThaiTaiKhoan.BiBan)
                                        {
                                            <span class="badge bg-danger">
                                                Bị ban
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Không xác định
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center text-nowrap">
                                        <a asp-action="Details"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn btn-sm btn-outline-primary">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>