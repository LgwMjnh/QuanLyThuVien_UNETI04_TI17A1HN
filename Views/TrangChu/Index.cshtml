@{
    ViewData["Title"] = "Trang chủ";

    var danhSachSachMoi = ViewBag.DanhSachSachMoi
        as List<QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach>
        ?? new List<QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach>();

    var danhSachSachNoiBat = ViewBag.DanhSachSachNoiBat
        as List<QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach>
        ?? new List<QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach>();

    var danhSachTheLoaiGoiY = ViewBag.DanhSachTheLoaiGoiY
        as List<QuanLyThuVien_UNETI04_TI17A1HN.Models.TheLoai>
        ?? new List<QuanLyThuVien_UNETI04_TI17A1HN.Models.TheLoai>();
}

<div class="public-home">

    <section class="home-hero">

        <!-- CỘT BÊN TRÁI: NỘI DUNG GIỚI THIỆU -->
        <div class="home-hero-content">

            <span class="home-eyebrow">
                THƯ VIỆN UNETI
                <img src="~/images/logo.png"
                     alt="Logo Thư viện UNETI"
                     asp-append-version="true" />
            </span>

            <h1 class="home-hero-title">
                Tri thức mở lối
                <span>tương lai.</span>
            </h1>

            <p class="home-hero-description">
                Khám phá không gian tri thức với hàng nghìn đầu sách
                phục vụ học tập, nghiên cứu và phát triển bản thân.
                Hãy bắt đầu hành trình khám phá của bạn tại thư viện UNETI.
            </p>

            <div class="home-hero-actions">

                <a asp-controller="Sach"
                   asp-action="Index"
                   class="home-button-primary">
                    Khám phá sách
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="home-button-secondary">
                    Tìm hiểu thêm
                </a>

            </div>

        </div>

        <div class="home-hero-image">
            <img src="~/images/anh_nen_trang_chu.png"
                 alt="Không gian thư viện UNETI"
                 asp-append-version="true" />
        </div>

    </section>


    <!-- banner slide chay anh -->
    @{
        var danhSachSlides = ViewBag.DanhSachSlides as List<string>
            ?? new List<string>();
    }

    @if (danhSachSlides.Count > 0)
    {
        <section class="home-slideshow" id="homeSlideshow">
            <div class="home-section-heading">

                <div>
                    @* <span class="home-eyebrow">KHÁM PHÁ TRI THỨC</span> *@

                    <h2>Khám phá thế giới qua từng trang sách</h2>

                    <p>
                        Từ tri thức, lịch sử, văn học cho đến những câu chuyện tiểu thuyết 
                    </p>
                </div>

                <a asp-controller="Sach"
                   asp-action="Index"
                   class="home-view-all">
                    Xem tất cả sách →
                </a>

            </div>

            <div class="slideshow-track">

                @for (int i = 0; i < danhSachSlides.Count; i++)
                {
                    <div class="slideshow-item @(i == 0 ? "active" : "")">
                        <img src="@danhSachSlides[i]"
                             alt="Hình ảnh giới thiệu thư viện - @(i + 1)" />
                    </div>
                }

            </div>

            @if (danhSachSlides.Count > 1)
            {
                <button type="button"
                        class="slideshow-control slideshow-prev"
                        aria-label="Ảnh trước">
                    &#10094;
                </button>

                <button type="button"
                        class="slideshow-control slideshow-next"
                        aria-label="Ảnh tiếp theo">
                    &#10095;
                </button>

                <div class="slideshow-indicators">
                    @for (int i = 0; i < danhSachSlides.Count; i++)
                    {
                        <button type="button"
                                class="slideshow-indicator @(i == 0 ? "active" : "")"
                                data-slide="@i"
                                aria-label="Chuyển đến ảnh @(i + 1)">
                        </button>
                    }
                </div>
            }

        </section>
    }
    else
    {
        <section class="home-slideshow-empty">
            <p>Chưa có hình ảnh trình chiếu.</p>
        </section>
    }

