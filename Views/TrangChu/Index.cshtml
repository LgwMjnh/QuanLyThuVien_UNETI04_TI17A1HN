    <script>


            document.addEventListener("DOMContentLoaded", function () {

                const slideshow = document.getElementById("homeSlideshow");

                if (!slideshow) return;

                const track = slideshow.querySelector(".slideshow-track");
                const slides = Array.from(
                    track.querySelectorAll(".slideshow-item")
                );

                const indicators = slideshow.querySelectorAll(".slideshow-indicator");
                const nextButton = slideshow.querySelector(".slideshow-next");
                const prevButton = slideshow.querySelector(".slideshow-prev");
                const indicatorBox = slideshow.querySelector(".slideshow-indicators");

                let visibleCount = 0;
                let currentIndex = 0;
                let slideshowTimer;
                let resizeTimer;

                const transitionStyle = "transform 0.65s ease";

                // Xác định số ảnh hiển thị theo kích thước màn hình.
                function getVisibleCount() {

                    if (window.innerWidth <= 767.98) {
                        return 1;
                    }

                    if (window.innerWidth <= 991.98) {
                        return 2;
                    }

                    return 4;
                }

                // Cập nhật trạng thái các dấu chấm.
                function updateIndicators() {

                    indicators.forEach((indicator, i) => {

                        indicator.classList.toggle(
                            "active",
                            i === currentIndex
                        );

                    });
                }

                // Cập nhật vị trí băng chuyền.
                function updateSlideshow(animate = true) {

                    track.style.transition = animate
                        ? transitionStyle
                        : "none";

                    if (slides.length <= visibleCount) {
                        track.style.transform = "translateX(0)";
                    } else {

                        const position = visibleCount + currentIndex;

                        track.style.transform =
                            `translateX(-${position * 100 / visibleCount}%)`;
                    }

                    updateIndicators();

                    if (!animate) {
                        track.offsetHeight;
                        track.style.transition = transitionStyle;
                    }
                }

                // Bắt đầu tự động chuyển ảnh.
                function startSlideshow() {

                    clearInterval(slideshowTimer);

                    if (slides.length <= visibleCount) return;

                    slideshowTimer = setInterval(function () {
                        nextSlide();
                    }, 4000);
                }

                // Chuyển sang ảnh tiếp theo.
                function nextSlide() {

                    if (slides.length <= visibleCount) return;

                    currentIndex++;
                    updateSlideshow();
                }

                // Chuyển về ảnh trước.
                function previousSlide() {

                    if (slides.length <= visibleCount) return;

                    currentIndex--;
                    updateSlideshow();
                }

                // Xử lý vòng lặp vô hạn.
                track.addEventListener("transitionend", function (event) {

                    if (
                        event.target !== track ||
                        event.propertyName !== "transform"
                    ) {
                        return;
                    }

                    if (currentIndex >= slides.length) {

                        currentIndex = 0;
                        updateSlideshow(false);

                    } else if (currentIndex < 0) {

                        currentIndex = slides.length - 1;
                        updateSlideshow(false);

                    }
                });

                // Thiết lập lại slideshow khi số ảnh hiển thị thay đổi.
                function rebuildSlideshow() {

                    const newVisibleCount = getVisibleCount();

                    if (newVisibleCount === visibleCount && visibleCount !== 0) {
                        return;
                    }

                    visibleCount = newVisibleCount;

                    currentIndex = currentIndex % slides.length;

                    track.style.transition = "none";
                    track.style.transform = "translateX(0)";

                    track.style.setProperty("--visible-count", visibleCount);

                    // Xóa các ảnh cũ và tạo lại băng chuyền.
                    if (slides.length > visibleCount) {

                        const firstClones = slides
                            .slice(-visibleCount)
                            .map(slide => slide.cloneNode(true));

                        const lastClones = slides
                            .slice(0, visibleCount)
                            .map(slide => slide.cloneNode(true));

                        track.replaceChildren(
                            ...firstClones,
                            ...slides,
                            ...lastClones
                        );

                    } else {

                        track.replaceChildren(...slides);
                    }

                    // Ẩn hoặc hiện các nút điều khiển phù hợp.
                    const canSlide = slides.length > visibleCount;

                    if (nextButton) nextButton.hidden = !canSlide;
                    if (prevButton) prevButton.hidden = !canSlide;
                    if (indicatorBox) indicatorBox.hidden = !canSlide;

                    updateSlideshow(false);
                    startSlideshow();
                }

                // Sự kiện nút tiếp theo.
                if (nextButton) {

                    nextButton.addEventListener("click", function () {

                        nextSlide();
                        startSlideshow();

                    });
                }

                // Sự kiện nút quay lại.
                if (prevButton) {

                    prevButton.addEventListener("click", function () {

                        previousSlide();
                        startSlideshow();

                    });
                }

                // Sự kiện các dấu chấm.
                indicators.forEach((indicator, i) => {

                    indicator.addEventListener("click", function () {

                        if (slides.length <= visibleCount) return;

                        currentIndex = i;

                        updateSlideshow();
                        startSlideshow();

                    });
                });

                // Khởi tạo slideshow.
                rebuildSlideshow();

                // Tự điều chỉnh khi thay đổi kích thước trình duyệt.
                window.addEventListener("resize", function () {

                    clearTimeout(resizeTimer);

                    resizeTimer = setTimeout(function () {
                        rebuildSlideshow();
                    }, 150);

                });

            });

    </script>

</div>