
@model QuanLyThuVien_UNETI04_TI17A1HN.Models.TheLoai

@{
    ViewData["Title"] = "Xóa thể loại";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="mb-1">Xóa thể loại</h1>
        <p class="text-muted mb-0">
            Xác nhận xóa thể loại sách khỏi hệ thống thư viện.
        </p>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Thông tin thể loại
        </div>

        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["Success"]
                </div>
            }

            <div class="alert alert-warning" role="alert">
                Bạn có chắc chắn muốn xóa thể loại này không?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.MaTheLoai)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.MaTheLoai)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.TenTheLoai)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.TenTheLoai)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.MoTa)
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.MoTa)
                        ? "Chưa có mô tả"
                        : Model.MoTa)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.TrangThai)
                </dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Ngừng hoạt động
                        </span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-matheloai="@Model.MaTheLoai"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaTheLoai" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        Xác nhận xóa
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
