@model QuanLyThuVien_UNETI04_TI17A1HN.Models.TheLoai

@{
    ViewData["Title"] = "Chi tiết thể loại";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="mb-1">Chi tiết thể loại</h1>
        <p class="text-muted mb-0">Thông tin chi tiết thể loại sách trong hệ thống thư viện</p>
    </div>

    <div class="card">
        <div class="card-header py-3">
            Thông tin thể loại
        </div>

        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.MaTheLoai)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.MaTheLoai)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.TenTheLoai)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.TenTheLoai)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.MoTa)
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.MoTa)
                        ? "Chưa có mô tả"
                        : Model.MoTa)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.TrangThai)
                </dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                    }
                </dd>
            </dl>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Edit"
                   asp-route-matheloai="@Model.MaTheLoai"
                   class="btn btn-primary">
                    Sửa thể loại
                </a>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>