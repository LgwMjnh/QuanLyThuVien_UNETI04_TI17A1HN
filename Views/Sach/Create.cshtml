@model QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach

@{
    ViewData["Title"] = "Thêm Sách mới";
}

<h1>Thêm Sách</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="TenSach" class="control-label"></label>
                <input asp-for="TenSach" class="form-control" />
                <span asp-validation-for="TenSach" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaTheLoai" class="control-label">Thể loại</label>
                <select asp-for="MaTheLoai" class="form-control" asp-items="ViewBag.MaTheLoai"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TacGia" class="control-label"></label>
                <input asp-for="TacGia" class="form-control" />
                <span asp-validation-for="TacGia" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SoLuong" class="control-label"></label>
                <input asp-for="SoLuong" class="form-control" type="number" min="0" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SoLuongCon" class="control-label"></label>
                <input asp-for="SoLuongCon" class="form-control" type="number" min="0" />
                <span asp-validation-for="SoLuongCon" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Tạo" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}