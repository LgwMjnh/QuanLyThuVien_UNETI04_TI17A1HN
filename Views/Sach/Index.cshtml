@using QuanLyThuVien_UNETI04_TI17A1HN.Helpers
@model QuanLyThuVien_UNETI04_TI17A1HN.Models.SachFilterViewModel

@{
    var laAdmin = QuyenTruyCap.LaAdmin(Context);
    var laDocGia = QuyenTruyCap.LaDocGia(Context);
    ViewData["Title"] = laAdmin ? "Quản lý & Tra cứu Sách" : "Tra cứu & Mượn Sách";
}

<style>
    .split-view-list {
        max-height: 650px;
        overflow-y: auto;
    }

    .split-view-list::-webkit-scrollbar {
        width: 5px;
    }

    .split-view-list::-webkit-scrollbar-thumb {
        background: var(--library-border);
        border-radius: 4px;
    }

    .book-item-card {
        cursor: pointer;
        transition: all .15s ease-in-out;
        border: 1px solid var(--library-border);
        background: var(--library-paper);
    }

    .book-item-card:hover {
        border-color: var(--library-green);
        background: rgba(231, 238, 231, 0.45);
    }

    .book-item-card.active-card {
        border-color: var(--library-green) !important;
        background: var(--library-green-soft) !important;
        box-shadow: 0 2px 8px rgba(41, 75, 58, .15);
    }

    .detail-sticky-pane {
        position: sticky;
        top: 20px;
        max-height: 760px;
        overflow-y: auto;
    }

    .book-description {
        max-height: 120px;
        overflow-y: auto;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .search-highlight {
        background-color: var(--library-green);
        color: #ffffff;
        padding: 1px 4px;
        border-radius: 3px;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-3 py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                @(laAdmin ? "Quản lý & Tra cứu Sách" : "Tra cứu & Mượn Sách")
            </h3>
            <small class="text-muted">
                @(laAdmin
                    ? "Hệ thống thư viện UNETI • Phân hệ Quản lý Sách (Module 2)"
                    : "Hệ thống thư viện UNETI • Tra cứu tài liệu và đăng ký mượn trực tuyến")
            </small>
        </div>

        @if (laAdmin)
        {
            <a asp-controller="Sach" asp-action="Create"
               class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm sách mới
            </a>
        }
        else
        {
            <div class="d-flex gap-2">
                @if (laDocGia)
                {
                    <a asp-controller="PhieuMuon" asp-action="Index"
                       class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-card-list me-1"></i> Phiếu mượn của tôi
                    </a>
                }
                <a asp-controller="PhieuMuon" asp-action="DangKy"
                   class="btn btn-primary btn-sm px-3 shadow-sm">
                    <i class="bi bi-journal-plus me-1"></i> Đăng ký mượn sách
                </a>
            </div>
        }
    </div>

    <div class="row g-3 align-items-start">

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-light border-bottom p-3">
                    <div class="row g-2">
                        <div class="col-12">
                            <label for="liveSearchInput" class="form-label small fw-semibold mb-1">
                                Tìm kiếm sách
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                <input type="text"
                                       id="liveSearchInput"
                                       class="form-control"
                                       placeholder="Nhập tên sách, tác giả, nhà xuất bản, mã sách (VD: T9LS500021)..."
                                       value="@Model.Search"
                                       autocomplete="off" />
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <label for="liveCategoryFilter" class="form-label small fw-semibold mb-1">
                                Thể loại
                            </label>
                            <select id="liveCategoryFilter" class="form-select form-select-sm">
                                <option value="">Tất cả thể loại</option>
                                @foreach (var cat in Model.DanhSachTheLoai)
                                {
                                    <option value="@cat" selected="@(Model.TheLoai == cat)">@cat</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-3">
                            <label for="livePublisherFilter" class="form-label small fw-semibold mb-1">
                                Nhà xuất bản
                            </label>
                            <select id="livePublisherFilter" class="form-select form-select-sm">
                                <option value="">Tất cả NXB</option>
                                @foreach (var nxb in Model.DanhSachNhaXuatBan)
                                {
                                    <option value="@nxb" selected="@(Model.NhaXuatBan == nxb)">@nxb</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-3">
                            <label for="liveStatusFilter" class="form-label small fw-semibold mb-1">
                                Trạng thái
                            </label>
                            <select id="liveStatusFilter" class="form-select form-select-sm">
                                <option value="">Tất cả trạng thái</option>
                                <option value="Đang phục vụ" selected="@(Model.TrangThai == "Đang phục vụ")">Đang phục vụ</option>
                                <option value="Tạm ngừng" selected="@(Model.TrangThai == "Tạm ngừng")">Tạm ngừng</option>
                                <option value="Ngừng phục vụ" selected="@(Model.TrangThai == "Ngừng phục vụ")">Ngừng phục vụ</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-3">
                            <label for="liveSortSelect" class="form-label small fw-semibold mb-1">
                                Sắp xếp
                            </label>
                            <select id="liveSortSelect" class="form-select form-select-sm">
                                <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên: A → Z</option>
                                <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên: Z → A</option>
                                <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá: Thấp → Cao</option>
                                <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá: Cao → Thấp</option>
                                <option value="year_desc" selected="@(Model.SortOrder == "year_desc")">Năm XB: Mới nhất</option>
                                <option value="year_asc" selected="@(Model.SortOrder == "year_asc")">Năm XB: Cũ nhất</option>
                                <option value="stock_desc" selected="@(Model.SortOrder == "stock_desc")">Tồn kho: Nhiều → Ít</option>
                                <option value="stock_asc" selected="@(Model.SortOrder == "stock_asc")">Tồn kho: Ít → Nhiều</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label for="liveYearFrom" class="form-label small fw-semibold mb-1">
                                Từ năm
                            </label>
                            <input type="number" id="liveYearFrom" class="form-control form-control-sm"
                                   placeholder="VD: 2018" value="@Model.NamTu" />
                        </div>

                        <div class="col-6 col-md-4">
                            <label for="liveYearTo" class="form-label small fw-semibold mb-1">
                                Đến năm
                            </label>
                            <input type="number" id="liveYearTo" class="form-control form-control-sm"
                                   placeholder="@DateTime.Now.Year" value="@Model.NamDen" />
                        </div>

                        <div class="col-12 col-md-4 d-flex align-items-end">
                            <button type="button" id="resetFilters" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body p-2 position-relative" id="bookResultsContainer">
                    @await Html.PartialAsync("_DanhSachSachPartial", Model)
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 detail-sticky-pane">
                <div class="card-header border-bottom p-3 d-flex justify-content-between align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary text-truncate" id="dCategory">Thể loại</span>
                    <span id="dStatusBadge" class="badge bg-success text-nowrap flex-shrink-0">Đang phục vụ</span>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex gap-3 align-items-start mb-3">
                        <div class="flex-shrink-0">
                            <img id="dCoverImg"
                                 src="/images/books/default-cover.svg"
                                 onerror="this.src='/images/books/default-cover.svg'"
                                 alt="Ảnh bìa sách"
                                 class="rounded-3 border shadow-sm"
                                 style="width: 110px; height: 154px; object-fit: cover;" />
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h5 class="fw-bold text-dark mb-1" id="dTitle">Chọn một cuốn sách để xem chi tiết</h5>
                            <p class="text-muted small mb-2">Tác giả: <strong class="text-dark" id="dAuthor">-</strong></p>

                            <div class="p-2 border rounded-2 bg-light mb-2">
                                <small class="text-muted d-block" style="font-size: 0.72rem;">Mã sách</small>
                                <strong class="text-primary font-monospace fs-6 d-block" id="dId">#T9LS500021</strong>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3 d-flex justify-content-between align-items-center">
                        <span class="fw-medium text-secondary small">Tình trạng tồn kho:</span>
                        <strong id="dRemaining" class="text-success fw-bold fs-6">Còn 0 cuốn</strong>
                    </div>

                    <div class="row g-2 mb-3 text-center">
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-light">
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Giá</small>
                                <strong class="text-success" id="dPrice">0 VNĐ</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-light">
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Năm XB</small>
                                <strong class="text-dark" id="dYear">-</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-light">
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Nhà xuất bản</small>
                                <strong class="text-dark text-truncate d-block" id="dPublisher">-</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.75rem;">Mô tả tóm tắt</small>
                        <div class="p-3 bg-light rounded-3 border text-secondary small book-description" id="dDesc">
                            Chọn sách để xem mô tả chi tiết.
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        @if (laAdmin)
                        {
                            <a id="btnEditLink" href="#" class="btn btn-warning flex-grow-1 btn-sm fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Sửa sách
                            </a>
                            <a id="btnDetailsLink" href="#" class="btn btn-outline-primary btn-sm px-3">
                                Chi tiết
                            </a>
                            <a id="btnDeleteLink" href="#" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </a>
                        }
                        else
                        {
                            <a id="btnBorrowLink" href="#" class="btn btn-primary flex-grow-1 btn-sm fw-bold">
                                <i class="bi bi-journal-plus me-1"></i> Mượn sách này
                            </a>
                            <a id="btnDetailsLink" href="#" class="btn btn-outline-primary btn-sm px-3">
                                Xem chi tiết
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        let currentSelectedBookId = null;
        let searchDebounceTimer = null;
        let currentPageIndex = @Model.PageIndex;

        function highlightKeywords() {
            const query = (document.getElementById("liveSearchInput").value || "").trim();
            if (!query) return;

            const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${escaped})`, 'gi');

            document.querySelectorAll("#bookCardList .card-book-title, #bookCardList .card-book-author, #bookCardList .card-book-code").forEach(el => {
                const raw = el.textContent;
                el.innerHTML = raw.replace(regex, '<span class="search-highlight">$1</span>');
            });
        }

        function selectBook(id) {
            currentSelectedBookId = id;
            document.querySelectorAll(".book-item-card").forEach(el => el.classList.remove("active-card"));
            const card = document.getElementById("card-" + id);
            if (!card) return;

            card.classList.add("active-card");

            const code = card.getAttribute("data-code") || ("T9LS5" + String(id).padStart(5, "0"));
            const cover = card.getAttribute("data-cover") || "/images/books/default-cover.svg";
            const title = card.getAttribute("data-title");
            const author = card.getAttribute("data-author");
            const category = card.getAttribute("data-category");
            const publisher = card.getAttribute("data-publisher");
            const year = card.getAttribute("data-year");
            const price = card.getAttribute("data-price");
            const remaining = parseInt(card.getAttribute("data-remaining")) || 0;
            const status = card.getAttribute("data-status");
            const desc = card.getAttribute("data-desc");

            document.getElementById("dId").innerText = "#" + code;
            document.getElementById("dCoverImg").src = cover;
            document.getElementById("dTitle").innerText = title;
            document.getElementById("dAuthor").innerText = author;
            document.getElementById("dCategory").innerText = category;
            document.getElementById("dPublisher").innerText = publisher;
            document.getElementById("dYear").innerText = year;
            document.getElementById("dPrice").innerText = price + " VNĐ";
            document.getElementById("dDesc").innerText = desc;

            const remainingEl = document.getElementById("dRemaining");
            if (remaining === 0) {
                remainingEl.innerText = "Hết sách";
                remainingEl.className = "text-danger fw-bold fs-6";
            } else {
                remainingEl.innerText = "Còn " + remaining + " cuốn";
                remainingEl.className = "text-success fw-bold fs-6";
            }

            const sBadge = document.getElementById("dStatusBadge");
            sBadge.innerText = status;
            sBadge.className = "badge text-nowrap flex-shrink-0 " + (status === "Đang phục vụ" ? "bg-success" : (status === "Tạm ngừng" ? "bg-warning text-dark" : "bg-secondary"));

            const btnEdit = document.getElementById("btnEditLink");
            if (btnEdit) {
                btnEdit.href = card.getAttribute("data-edit-url") || "#";
            }

            const btnDelete = document.getElementById("btnDeleteLink");
            if (btnDelete) {
                btnDelete.href = card.getAttribute("data-delete-url") || "#";
            }

            const btnDetails = document.getElementById("btnDetailsLink");
            if (btnDetails) {
                btnDetails.href = card.getAttribute("data-details-url") || "#";
            }

            const btnBorrow = document.getElementById("btnBorrowLink");
            if (btnBorrow) {
                if (status === "Đang phục vụ" && remaining > 0) {
                    btnBorrow.href = card.getAttribute("data-borrow-url") || "#";
                    btnBorrow.className = "btn btn-primary flex-grow-1 btn-sm fw-bold";
                    btnBorrow.innerHTML = '<i class="bi bi-journal-plus me-1"></i> Mượn sách này';
                } else {
                    btnBorrow.href = "#";
                    btnBorrow.className = "btn btn-secondary flex-grow-1 btn-sm fw-bold disabled pe-none";
                    btnBorrow.innerHTML = '<i class="bi bi-slash-circle me-1"></i> Tạm hết sách / Không phục vụ';
                }
            }
        }

        function selectFirstBook() {
            const firstCard = document.querySelector("#bookCardList .book-item-card");
            if (firstCard) {
                selectBook(firstCard.getAttribute("data-id"));
            } else {
                document.getElementById("dId").innerText = "#0000000000";
                document.getElementById("dCoverImg").src = "/images/books/default-cover.svg";
                document.getElementById("dTitle").innerText = "Không có sách nào";
                document.getElementById("dAuthor").innerText = "-";
                document.getElementById("dCategory").innerText = "Chưa phân loại";
                document.getElementById("dPublisher").innerText = "-";
                document.getElementById("dYear").innerText = "-";
                document.getElementById("dPrice").innerText = "0 VNĐ";
                document.getElementById("dDesc").innerText = "Không tìm thấy dữ liệu phù hợp.";
                const remainingEl = document.getElementById("dRemaining");
                remainingEl.innerText = "Còn 0 cuốn";
                remainingEl.className = "text-muted fw-bold fs-6";

                const btnBorrow = document.getElementById("btnBorrowLink");
                if (btnBorrow) {
                    btnBorrow.href = "#";
                    btnBorrow.className = "btn btn-secondary flex-grow-1 btn-sm fw-bold disabled pe-none";
                }
            }
        }

        function loadBooksAjax(page = 1) {
            currentPageIndex = page;

            const search = encodeURIComponent((document.getElementById("liveSearchInput").value || "").trim());
            const theLoai = encodeURIComponent(document.getElementById("liveCategoryFilter").value || "");
            const nhaXuatBan = encodeURIComponent(document.getElementById("livePublisherFilter").value || "");
            const trangThai = encodeURIComponent(document.getElementById("liveStatusFilter").value || "");
            const sort = encodeURIComponent(document.getElementById("liveSortSelect").value || "name_asc");
            const namTu = encodeURIComponent(document.getElementById("liveYearFrom").value || "");
            const namDen = encodeURIComponent(document.getElementById("liveYearTo").value || "");

            const url = `/Sach/Index?search=${search}&theLoai=${theLoai}&nhaXuatBan=${nhaXuatBan}&trangThai=${trangThai}&namTu=${namTu}&namDen=${namDen}&sort=${sort}&page=${page}&isAjax=true`;

            const container = document.getElementById("bookResultsContainer");
            container.style.opacity = "0.5";

            fetch(url, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = "1";
                highlightKeywords();
                selectFirstBook();
            })
            .catch(err => {
                container.style.opacity = "1";
            });
        }

        function goToPage(p) {
            loadBooksAjax(p);
        }

        document.getElementById("liveSearchInput").addEventListener("input", function() {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                loadBooksAjax(1);
            }, 250);
        });

        document.getElementById("liveCategoryFilter").addEventListener("change", () => loadBooksAjax(1));
        document.getElementById("livePublisherFilter").addEventListener("change", () => loadBooksAjax(1));
        document.getElementById("liveStatusFilter").addEventListener("change", () => loadBooksAjax(1));
        document.getElementById("liveSortSelect").addEventListener("change", () => loadBooksAjax(1));
        document.getElementById("liveYearFrom").addEventListener("input", () => {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => loadBooksAjax(1), 350);
        });
        document.getElementById("liveYearTo").addEventListener("input", () => {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => loadBooksAjax(1), 350);
        });

        document.getElementById("resetFilters").addEventListener("click", function() {
            document.getElementById("liveSearchInput").value = "";
            document.getElementById("liveCategoryFilter").value = "";
            document.getElementById("livePublisherFilter").value = "";
            document.getElementById("liveStatusFilter").value = "";
            document.getElementById("liveSortSelect").value = "name_asc";
            document.getElementById("liveYearFrom").value = "";
            document.getElementById("liveYearTo").value = "";
            loadBooksAjax(1);
        });

        document.addEventListener("DOMContentLoaded", function() {
            highlightKeywords();
            selectFirstBook();
        });
    </script>
}
