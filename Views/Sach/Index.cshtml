@model IEnumerable<QuanLyThuVien_UNETI04_TI17A1HN.Models.Sach>

@{
    ViewData["Title"] = "Quản lý & Tra cứu Sách";
}

<style>
    .split-view-list {
        max-height: 720px;
        overflow-y: auto;
    }
    .split-view-list::-webkit-scrollbar {
        width: 5px;
    }
    .split-view-list::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }
    .book-item-card {
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
    }
    .book-item-card:hover {
        border-color: #93c5fd;
        background-color: #f8fafc;
    }
    .book-item-card.active-card {
        border-color: #3b82f6 !important;
        background-color: #eff6ff !important;
        box-shadow: 0 1px 3px 0 rgba(59, 130, 246, 0.15);
    }
    .detail-sticky-pane {
        position: sticky;
        top: 20px;
        max-height: 720px;
        overflow-y: auto;
    }
</style>

<div class="container-fluid px-3 py-2">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-0">Quản lý & Tra cứu Sách</h3>
            <small class="text-muted">Hệ thống thư viện UNETI • Phân hệ Quản lý Sách (Module 2)</small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
                + Thêm Sách mới
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center p-5 border-dashed border-2 bg-light">
            <div class="mb-3">
                <span style="font-size: 3rem;">📖</span>
            </div>
            <h5 class="fw-bold text-secondary">Chưa có cuốn sách nào trong kho thư viện</h5>
            <p class="text-muted small">Hãy bắt đầu bằng cách thêm mới các đầu sách vào hệ thống.</p>
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-primary px-4">Thêm cuốn sách đầu tiên</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 align-items-start">

            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light border-bottom p-3">
                        <div class="row g-2">
                            <div class="col-12">
                                <input type="text" id="liveSearchInput" oninput="applyFilters()" placeholder="Tìm kiếm theo tên sách, tác giả, NXB..." class="form-control form-control-sm" />
                            </div>
                            <div class="col-4">
                                <select id="liveCategoryFilter" onchange="applyFilters()" class="form-select form-select-sm">
                                    <option value="">Tất cả Thể loại</option>
                                    @foreach (var cat in Model.Select(m => m.TheLoai?.TenTheLoai).Where(t => !string.IsNullOrEmpty(t)).Distinct())
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <select id="liveStatusFilter" onchange="applyFilters()" class="form-select form-select-sm">
                                    <option value="">Tất cả Trạng thái</option>
                                    <option value="Đang phục vụ">Đang phục vụ</option>
                                    <option value="Tạm ngừng">Tạm ngừng</option>
                                    <option value="Ngừng phục vụ">Ngừng phục vụ</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <select id="liveSortSelect" onchange="applyFilters()" class="form-select form-select-sm">
                                    <option value="name_asc">Tên: A → Z</option>
                                    <option value="name_desc">Tên: Z → A</option>
                                    <option value="price_asc">Giá: Thấp → Cao</option>
                                    <option value="price_desc">Giá: Cao → Thấp</option>
                                    <option value="year_desc">Năm XB: Mới nhất</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-2 split-view-list" id="bookCardList">
                        @foreach (var item in Model)
                        {
                            var pct = item.SoLuong > 0 ? (int)Math.Round((double)item.SoLuongCon / item.SoLuong * 100) : 0;
                            var badgeClass = item.TrangThai == "Đang phục vụ" ? "bg-success" : (item.TrangThai == "Tạm ngừng" ? "bg-warning text-dark" : "bg-secondary");

                            <div class="p-3 mb-2 rounded-3 book-item-card"
                                 id="card-@item.MaSach"
                                 onclick="selectBook(@item.MaSach)"
                                 data-id="@item.MaSach"
                                 data-title="@item.TenSach"
                                 data-author="@item.TacGia"
                                 data-category="@(item.TheLoai?.TenTheLoai ?? "Chưa phân loại")"
                                 data-publisher="@item.NhaXuatBan"
                                 data-year="@item.NamXuatBan"
                                 data-price="@item.GiaSach.ToString("N0")"
                                 data-rawprice="@item.GiaSach"
                                 data-total="@item.SoLuong"
                                 data-remaining="@item.SoLuongCon"
                                 data-status="@item.TrangThai"
                                 data-desc="@(string.IsNullOrEmpty(item.MoTa) ? "Chưa có thông tin mô tả chi tiết cho sách này." : item.MoTa)">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-light text-secondary border">#@item.MaSach</span>
                                            <span class="badge bg-primary-subtle text-primary">@(item.TheLoai?.TenTheLoai ?? "Chưa phân loại")</span>
                                            <span class="badge @badgeClass ms-auto">@item.TrangThai</span>
                                        </div>
                                        <h6 class="fw-bold text-dark text-truncate mb-1">@item.TenSach</h6>
                                        <small class="text-muted d-block text-truncate">Tác giả: <strong>@item.TacGia</strong></small>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <span class="fw-bold text-success d-block">@item.GiaSach.ToString("N0") VNĐ</span>
                                        <small class="@(item.SoLuongCon == 0 ? "text-danger fw-bold" : "text-muted")">
                                            @(item.SoLuongCon == 0 ? "Hết sách" : $"Còn {item.SoLuongCon}/{item.SoLuong} cuốn")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted" id="filterCountStatus">Tổng số: @Model.Count() cuốn sách</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 detail-sticky-pane">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary-subtle text-primary" id="dCategory">Thể loại</span>
                        <span id="dStatusBadge" class="badge bg-success">Đang phục vụ</span>
                    </div>

                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-1" id="dTitle">Chọn một cuốn sách để xem</h5>
                        <p class="text-muted small mb-3">Tác giả: <strong class="text-dark" id="dAuthor">-</strong></p>

                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span class="fw-medium text-secondary">Tình trạng tồn kho:</span>
                                <strong id="dStockFraction">0 / 0</strong>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div id="dProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem; margin-top: 4px;">
                                <span>Còn: <b id="dRemaining" class="text-success">0</b></span>
                                <span>Tổng: <b id="dTotal">0</b></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3 text-center">
                            <div class="col-6">
                                <div class="p-2 border rounded-2 bg-light">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Mã quản lý</small>
                                    <strong class="text-dark font-monospace" id="dId">#0</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded-2 bg-light">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Giá bìa</small>
                                    <strong class="text-success" id="dPrice">0 VNĐ</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded-2 bg-light">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Năm xuất bản</small>
                                    <strong class="text-dark" id="dYear">-</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded-2 bg-light">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Nhà xuất bản</small>
                                    <strong class="text-dark text-truncate d-block" id="dPublisher">-</strong>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <small class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.75rem;">Mô tả tóm tắt</small>
                            <div class="p-3 bg-light rounded-3 border text-secondary small" style="max-height: 140px; overflow-y: auto;" id="dDesc">
                                Chọn sách để xem mô tả.
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a id="btnEditLink" href="#" class="btn btn-warning flex-grow-1 btn-sm fw-bold">
                                Sửa sách
                            </a>
                            <a id="btnDeleteLink" href="#" class="btn btn-outline-danger btn-sm px-3">
                                Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        let currentSelectedBookId = null;

        function selectBook(id) {
            currentSelectedBookId = id;
            document.querySelectorAll(".book-item-card").forEach(el => el.classList.remove("active-card"));
            const card = document.getElementById("card-" + id);
            if (!card) return;

            card.classList.add("active-card");

            const title = card.getAttribute("data-title");
            const author = card.getAttribute("data-author");
            const category = card.getAttribute("data-category");
            const publisher = card.getAttribute("data-publisher");
            const year = card.getAttribute("data-year");
            const price = card.getAttribute("data-price");
            const total = parseInt(card.getAttribute("data-total")) || 0;
            const remaining = parseInt(card.getAttribute("data-remaining")) || 0;
            const status = card.getAttribute("data-status");
            const desc = card.getAttribute("data-desc");

            document.getElementById("dId").innerText = "#" + id;
            document.getElementById("dTitle").innerText = title;
            document.getElementById("dAuthor").innerText = author;
            document.getElementById("dCategory").innerText = category;
            document.getElementById("dPublisher").innerText = publisher;
            document.getElementById("dYear").innerText = year;
            document.getElementById("dPrice").innerText = price + " VNĐ";
            document.getElementById("dDesc").innerText = desc;
            document.getElementById("dRemaining").innerText = remaining;
            document.getElementById("dTotal").innerText = total;

            const pct = total > 0 ? Math.round((remaining / total) * 100) : 0;
            document.getElementById("dStockFraction").innerText = remaining + " / " + total + " (" + pct + "%)";
            const pBar = document.getElementById("dProgressBar");
            pBar.style.width = pct + "%";
            pBar.className = "progress-bar " + (remaining === 0 ? "bg-danger" : (pct < 30 ? "bg-warning" : "bg-success"));

            const sBadge = document.getElementById("dStatusBadge");
            sBadge.innerText = status;
            sBadge.className = "badge " + (status === "Đang phục vụ" ? "bg-success" : (status === "Tạm ngừng" ? "bg-warning text-dark" : "bg-secondary"));

            document.getElementById("btnEditLink").href = "/Sach/Edit/" + id;
            document.getElementById("btnDeleteLink").href = "/Sach/Delete/" + id;
        }

        function applyFilters() {
            const query = (document.getElementById("liveSearchInput").value || "").toLowerCase().trim();
            const category = document.getElementById("liveCategoryFilter").value;
            const status = document.getElementById("liveStatusFilter").value;
            const sort = document.getElementById("liveSortSelect").value;

            const cards = Array.from(document.querySelectorAll(".book-item-card"));
            let visibleCards = [];

            cards.forEach(card => {
                const title = (card.getAttribute("data-title") || "").toLowerCase();
                const author = (card.getAttribute("data-author") || "").toLowerCase();
                const publisher = (card.getAttribute("data-publisher") || "").toLowerCase();
                const cat = card.getAttribute("data-category") || "";
                const st = card.getAttribute("data-status") || "";

                const matchQ = !query || title.includes(query) || author.includes(query) || publisher.includes(query);
                const matchCat = !category || cat === category;
                const matchStatus = !status || st === status;

                if (matchQ && matchCat && matchStatus) {
                    card.style.display = "";
                    visibleCards.push(card);
                } else {
                    card.style.display = "none";
                }
            });

            if (sort === "name_asc") visibleCards.sort((a,b) => a.getAttribute("data-title").localeCompare(b.getAttribute("data-title")));
            if (sort === "name_desc") visibleCards.sort((a,b) => b.getAttribute("data-title").localeCompare(a.getAttribute("data-title")));
            if (sort === "price_asc") visibleCards.sort((a,b) => parseFloat(a.getAttribute("data-rawprice")) - parseFloat(b.getAttribute("data-rawprice")));
            if (sort === "price_desc") visibleCards.sort((a,b) => parseFloat(b.getAttribute("data-rawprice")) - parseFloat(a.getAttribute("data-rawprice")));
            if (sort === "year_desc") visibleCards.sort((a,b) => parseInt(b.getAttribute("data-year")) - parseInt(a.getAttribute("data-year")));

            const listContainer = document.getElementById("bookCardList");
            visibleCards.forEach(c => listContainer.appendChild(c));

            document.getElementById("filterCountStatus").innerText = "Hiển thị " + visibleCards.length + " trên tổng số " + cards.length + " cuốn sách";

            if (visibleCards.length > 0) {
                const stillVisible = visibleCards.some(c => c.getAttribute("data-id") == currentSelectedBookId);
                if (!stillVisible) {
                    selectBook(visibleCards[0].getAttribute("data-id"));
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const firstCard = document.querySelector(".book-item-card");
            if (firstCard) {
                selectBook(firstCard.getAttribute("data-id"));
            }
        });
    </script>
}