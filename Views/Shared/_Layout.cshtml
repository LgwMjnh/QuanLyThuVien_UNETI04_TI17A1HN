@using QuanLyThuVien_UNETI04_TI17A1HN.Helpers

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện UNETI</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien_UNETI04_TI17A1HN.styles.css" asp-append-version="true" />
</head>

<body>
    @{
        var laTrangDangNhap =
            ViewContext.RouteData.Values["controller"]?.ToString() == "DangNhap";

        var laAdmin = QuyenTruyCap.LaAdmin(Context);
        var laDocGia = QuyenTruyCap.LaDocGia(Context);
        var daDangNhap = QuyenTruyCap.DaDangNhap(Context);
    }

    @if (!laTrangDangNhap)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light border-bottom">
                <div class="container-fluid">

                    @* LOGO VÀ TÊN THƯ VIỆN *@
                    <a class="navbar-brand fw-bold d-flex align-items-center"
                       asp-area=""
                       asp-controller="TrangChu"
                       asp-action="Index">

                        <img src="~/images/logo.png"
                             alt="Logo Thư viện UNETI"
                             style="height: 42px; width: auto; margin-right: 8px;" />

                        Thư viện UNETI
                    </a>

                    @* NÚT MENU TRÊN ĐIỆN THOẠI *@
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarMain"
                            aria-controls="navbarMain"
                            aria-expanded="false"
                            aria-label="Mở menu">

                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarMain">

                        @* MENU CHÍNH *@
                        <ul class="navbar-nav me-auto">

                            @* TRANG CHỦ *@
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="TrangChu"
                                   asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>

                            @* MENU DÀNH CHO ADMIN *@
                            @if (laAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       id="menuQuanLy"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Quản lý
                                    </a>

                                    <ul class="dropdown-menu" aria-labelledby="menuQuanLy">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="TheLoai"
                                               asp-action="Index">
                                                Quản lý thể loại
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Sach"
                                               asp-action="Index">
                                                Quản lý sách
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DocGia"
                                               asp-action="Index">
                                                Quản lý độc giả
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="TaiKhoan"
                                               asp-action="Index">
                                                Quản lý tài khoản
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="PhieuMuon"
                                               asp-action="Index">
                                                Quản lý phiếu mượn
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="MuonTra"
                                               asp-action="Index">
                                                Quản lý mượn trả
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="ThongKe"
                                               asp-action="Index">
                                                Thống kê
                                            </a>
                                        </li>

                                    </ul>
                                </li>
                            }

                            @* MENU DÀNH CHO ĐỘC GIẢ *@
                            else if (laDocGia)
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Sach"
                                       asp-action="Index">
                                        Tra cứu sách
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="PhieuMuon"
                                       asp-action="DangKy">
                                        Đăng ký mượn
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="PhieuMuon"
                                       asp-action="Index">
                                        Phiếu mượn của tôi
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="DocGia"
                                       asp-action="HoSo">
                                        Hồ sơ cá nhân
                                    </a>
                                </li>
                            }

                            @* MENU DÀNH CHO KHÁCH *@
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Sach"
                                       asp-action="Index">
                                        Tra cứu sách
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Thông tin
                                    </a>
                                </li>
                            }

                        </ul>

                        @* KHU VỰC BÊN PHẢI THANH ĐIỀU HƯỚNG *@
                        <ul class="navbar-nav align-items-lg-center">

                            @if (daDangNhap)
                            {
                                @* NÚT DASHBOARD CHỈ HIỆN VỚI ADMIN *@
                                @if (laAdmin)
                                {
                                    <li class="nav-item me-lg-2">
                                        <a class="btn btn-outline-primary btn-sm"
                                           asp-controller="Home"
                                           asp-action="Index">
                                            Dashboard
                                        </a>
                                    </li>
                                }

                                @* TÊN NGƯỜI DÙNG *@
                                <li class="nav-item me-lg-2">
                                    <span class="nav-link">
                                        Xin chào,
                                        <strong>@Context.Session.GetString("HoTen")</strong>

                                        @if (laAdmin)
                                        {
                                            <span class="badge bg-danger ms-1">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary ms-1">Độc giả</span>
                                        }
                                    </span>
                                </li>

                                @* ĐĂNG XUẤT *@
                                <li class="nav-item">
                                    <form asp-controller="DangNhap"
                                          asp-action="DangXuat"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                @* ĐĂNG NHẬP *@
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm"
                                       asp-controller="DangNhap"
                                       asp-action="Index">
                                        Đăng nhập
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    @* NỘI DUNG TRANG *@
    <div class="@(laTrangDangNhap ? "container-fluid p-0" : "container")">
        <main role="main" class="@(laTrangDangNhap ? "p-0" : "pb-3")">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @if (TempData["ThongBao"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["ThongBao"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    @* CHÂN TRANG *@
    @if (!laTrangDangNhap)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Thư viện UNETI -
                <a asp-controller="Home" asp-action="Privacy">Thông tin</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/password-toggle.js"></script>
</body>
</html>
