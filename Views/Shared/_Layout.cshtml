<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyThuVien_UNETI04_TI17A1HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien_UNETI04_TI17A1HN.styles.css" asp-append-version="true" />
</head>

<body>

    @{
            var laTrangDangNhap =
                ViewContext.RouteData.Values["controller"]?.ToString() == "DangNhap";
        }
        @if (!laTrangDangNhap)
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Thư viện UNETI</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">


                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Thông tin</a>
                                </li>
                            </ul>


                            <ul class="navbar-nav align-items-sm-center">
                                @if (Context.Session.GetInt32("MaTaiKhoan") != null)
                                {
                                    <li class="nav-item">
                                        <span class="nav-link">
                                            Xin chào, <strong>@Context.Session.GetString("HoTen")</strong>
                                        </span>
                                    </li>
                                    <li class="nav-item ms-sm-2">
                                        <form asp-controller="DangNhap" asp-action="DangXuat" method="post">
                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item ms-sm-2">
                                        <a class="btn btn-primary btn-sm"
                                        asp-controller="DangNhap"
                                        asp-action="Index">
                                            Đăng nhập
                                        </a>
                                    </li>
                                }
                            </ul>




                        </div>
                    </div>
                </nav>
            </header>
        }



    <div class="@(laTrangDangNhap ? "container-fluid p-0" : "container")">
        <main role="main" class="@(laTrangDangNhap ? "p-0" : "pb-3")">
            @RenderBody()
        </main>
    </div>


    @if (!laTrangDangNhap)
{
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyThuVien_UNETI04_TI17A1HN - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
}


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/password-toggle.js"></script>
</body>
</html>
