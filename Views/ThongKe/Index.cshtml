@model QuanLyThuVien_UNETI04_TI17A1HN.Models.ThongKeViewModel

@{
    ViewData["Title"] = "Thống kê chi tiết";
}

<div class="container-fluid py-4">
    <!-- TIÊU ĐỀ VÀ NÚT QUAY LẠI -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold">THỐNG KÊ THƯ VIỆN</h2>
            <p class="text-muted mb-0">
                Tổng hợp tình hình sách, độc giả và hoạt động mượn trả.
            </p>
        </div>

        <a asp-controller="MuonTra"
           asp-action="Index"
           class="btn btn-outline-success">
            <i class="bi bi-arrow-left-circle me-2"></i>
            Quay lại quản lý mượn trả
        </a>
    </div>

    <!-- 6 THẺ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng phiếu mượn</div>
                    <h3 class="fw-bold">@Model.TongPhieuMuon</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đang mượn</div>
                    <h3 class="fw-bold">@Model.DangMuon</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đã trả</div>
                    <h3 class="fw-bold">@Model.DaTra</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Quá hạn</div>
                    <h3 class="fw-bold">@Model.QuaHan</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng độc giả</div>
                    <h3 class="fw-bold">@Model.TongDocGia</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đầu sách</div>
                    <h3 class="fw-bold">@Model.TongSach</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 1. SỐ ĐẦU SÁCH THEO THỂ LOẠI -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            1. Số đầu sách theo thể loại
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Thể loại</th>
                        <th>Số đầu sách</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SachTheoTheLoai.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                Chưa có dữ liệu thể loại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.SachTheoTheLoai)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.TenTheLoai</td>
                                <td>@item.SoDauSach</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. LƯỢT MƯỢN THEO SÁCH -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            2. Lượt mượn theo sách
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên sách</th>
                        <th>Số lượt có trong chi tiết phiếu</th>
                        <th>Tổng số cuốn được mượn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LuotMuonTheoSach.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Chưa có dữ liệu mượn sách.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.LuotMuonTheoSach)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.TenSach</td>
                                <td>@item.SoLuotMuon</td>
                                <td>@item.TongSoLuong</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. SỐ PHIẾU THEO TRẠNG THÁI -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            3. Số phiếu theo trạng thái
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Trạng thái</th>
                        <th>Số phiếu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PhieuTheoTrangThai.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                Chưa có dữ liệu phiếu mượn.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.PhieuTheoTrangThai)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.TrangThai</td>
                                <td>@item.SoPhieu</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. TOP 10 SÁCH ĐƯỢC MƯỢN NHIỀU NHẤT -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            4. Top 10 sách được mượn nhiều nhất
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Thứ hạng</th>
                        <th>Tên sách</th>
                        <th>Số lượt có trong chi tiết phiếu</th>
                        <th>Tổng số cuốn được mượn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopSachMuonNhieuNhat.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Chưa có dữ liệu mượn sách.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.TopSachMuonNhieuNhat)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.TenSach</td>
                                <td>@item.SoLuotMuon</td>
                                <td>@item.TongSoLuong</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 5. LƯỢT MƯỢN THEO ĐỘC GIẢ -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            5. Lượt mượn theo độc giả
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Họ tên độc giả</th>
                        <th>Số phiếu mượn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LuotMuonTheoDocGia.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                Chưa có dữ liệu mượn của độc giả.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.LuotMuonTheoDocGia)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.HoTen</td>
                                <td>@item.SoLuotMuon</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 6. PHIẾU MƯỢN THEO THÁNG -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            6. Phiếu mượn theo tháng
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Tháng</th>
                        <th>Năm</th>
                        <th>Số phiếu mượn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PhieuMuonTheoThang.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Chưa có dữ liệu thống kê theo tháng.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var item in Model.PhieuMuonTheoThang)
                        {
                            <tr>
                                <td>@(++stt)</td>
                                <td>@item.Thang</td>
                                <td>@item.Nam</td>
                                <td>@item.SoPhieu</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>